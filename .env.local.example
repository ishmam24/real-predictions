# Copy this file to `.env.local` and fill in the values. `.env*` is gitignored,
# so your real keys never get committed.

# football-data.org — free Premier League fixtures, scores, and standings.
# Get a free token: https://www.football-data.org/client/register
FOOTBALL_DATA_API_TOKEN=

# Supabase — database + auth. The anon key is public-by-design (RLS-protected).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase SERVICE ROLE key — server-only, bypasses Row Level Security. Used by
# the auto-settle cron (/api/cron/settle) to write fixture scores. NEVER expose
# this to the browser or commit it. Find it in Supabase → Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret guarding the settle cron. The scheduler must send it as
# `Authorization: Bearer <value>` (Vercel Cron sends CRON_SECRET automatically).
# Use a long random string, e.g. `openssl rand -hex 32`.
CRON_SECRET=

# Cloudflare Turnstile — CAPTCHA on the auth form (bot protection). Optional:
# leave blank to disable the CAPTCHA. When set, also enable Turnstile in
# Supabase → Auth → Attack Protection and paste the matching SECRET there.
# Create a free widget at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
